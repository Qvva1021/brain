# ============================================================
# 脑电情绪识别系统 —— 环境变量示例
# 后端通过 os.getenv 读取这些变量；不配置则使用默认值，开箱即用。
# 复制本文件为 .env 只是参考，真正的配置方式是设系统环境变量：
#   PowerShell:  $env:EEG_DATA_PATH = "D:\...\emotions.csv"
#   CMD:         set EEG_DATA_PATH=D:\...\emotions.csv
#   bash:        export EEG_DATA_PATH=/path/to/emotions.csv
# 设置后再启动后端即可生效。
# ============================================================

# 数据集 CSV 路径（默认：backend/../data/emotions.csv）
EEG_DATA_PATH=E:\作业\dl\brain\data\emotions.csv

# 训练好的模型保存路径（默认：backend/../models/emotion_svm.pkl）
# 删除该文件后重启后端会自动重新训练
EEG_MODEL_PATH=E:\作业\dl\brain\models\emotion_svm.pkl
